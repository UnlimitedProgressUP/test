# random.rand() 生成 0.0- 1.0之间,包左不包右 随机小数矩阵
a2=np.random.rand(3,5)    # 3行3列
print(a2)


# random.randint(开始,结束,size=(行,列 )) 生成 开始，结束 之间,包左不包右   随机整数矩阵
a3=np.random.randint(3,5,size=(2,3))    # 2行3列
print(a3)

#random.uniform(起始值, 结束值,size=(行,列)) 生成指定范围,包左不包右 随机小数矩阵
a4=np.random.uniform(2,3,size=(2,3)) # 2行3列
print(a4)
